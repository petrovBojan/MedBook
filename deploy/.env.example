# Copy to deploy/.env and fill in. .env is git-ignored - it holds secrets.

# The address people open, e.g. medbook.example.com (its DNS A record must point at this
# server). Use "localhost" to try the setup on your own PC (browser shows a certificate warning).
DOMAIN=medbook.example.com

# Signs login sessions. At least 64 random bytes - generate one with:
#   openssl rand -base64 64 | tr -d '\n'
# Changing it logs everyone out.
JWT_KEY=

# The super admin (platform owner) account, created on first start if none exists.
# Password at least 10 characters. Can be removed from this file after the first start.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Time zone for the demo clinic created in an empty database (IANA name).
CLINIC_TIME_ZONE=Europe/Skopje

# --- Appointment reminders (optional) ---
# Each clinic picks Email or SMS on its Settings page; a channel left empty here can't be picked.

# Email: any SMTP service (Brevo, Mailgun, Amazon SES, Oracle Email Delivery, a mailbox with an
# app password...). Use port 587 - most clouds block port 25. EMAIL_FROM must be an address
# the provider has verified for you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=MedBook

# SMS through Twilio (console.twilio.com → Account info). TWILIO_FROM is a Twilio number
# (+1...), an alphanumeric sender name like MedBook, or a Messaging Service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Added to numbers typed without a country code (070 123 456 -> +38970123456).
SMS_DEFAULT_COUNTRY_CODE=+389

# Where the API repo is, relative to this folder (default: ../../MedBook.Api).
# API_REPO=../../MedBook.Api
